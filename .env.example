# ==============================================================================
# VERITAS - AUTOMATED VASP ATTRIBUTION & BLOCKCHAIN INTELLIGENCE
# ENVIRONMENT CONFIGURATION MATRIX (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / PUBLIC CONFIGURATION (Safe to expose to browser)
# ------------------------------------------------------------------------------

# Base URL for frontend API client calls (Optional; defaults to relative '/api' or direct client RPC)
VITE_API_URL=http://localhost:3000

# Application Public Host URL
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE SECRETS (Keep secret! DO NOT prefix with VITE_)
# ------------------------------------------------------------------------------

# Server Port (Default: 3000)
PORT=3000

# Gemini AI API Key for server-side intelligence analysis (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. OPTIONAL BLOCKCHAIN INTELLIGENCE & LEA INTEGRATIONS (Server-Side Only)
# ------------------------------------------------------------------------------

# Optional Etherscan API key for Ethereum transaction indexing
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# SAHYOG Indian Cyber Crime Coordination Centre (I4C) LEA Gateway Integration
SAHYOG_AGENCY_ID=LEA-IND-CYBER-04
SAHYOG_API_KEY=your_sahyog_api_key_here
SAHYOG_MTLS_CERT=your_sahyog_mtls_cert_base64_here
